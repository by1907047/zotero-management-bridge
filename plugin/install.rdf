<?xml version="1.0"?>
<RDF xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:em="http://www.mozilla.org/2004/em-rdf#">
  <Description about="urn:mozilla:install-manifest">
    <em:id>zotero-management-bridge@example.org</em:id>
    <em:name>Zotero Management Bridge</em:name>
    <em:version>0.2.0-alpha.3</em:version>
    <em:description>Local Zotero management bridge for automation agents and scripts.</em:description>
    <em:creator>Zotero Management Bridge contributors</em:creator>
    <em:type>2</em:type>
    <em:bootstrap>true</em:bootstrap>
    <em:targetApplication>
      <Description>
        <em:id>zotero@zotero.org</em:id>
        <em:minVersion>6.999</em:minVersion>
        <em:maxVersion>9.*</em:maxVersion>
      </Description>
    </em:targetApplication>
  </Description>
</RDF>
